# VeriFlow AI Backend Environment Variables Example
DATABASE_URL=sqlite:///./veriflow.db
JWT_SECRET=super_secret_jwt_key_veriflow_2026
# TEE identity signing key. Generate a FRESH keypair: node scripts/generateTeeIdentity.js
# Never commit a real value. Never reuse a key that has appeared in git history.
ENCLAVE_SECRET_KEY=0xREPLACE_WITH_FRESHLY_GENERATED_TEE_IDENTITY_PRIVATE_KEY
ALLOWLISTED_ENCLAVE_MEASUREMENT=0x8f4a9b2c7e1d3f5a6b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=veriflow-encrypted-blobs
OPENAI_API_KEY=sk-proj-your_key
TEE_MODE=simulator
